---
import "@/styles/global.css";
import { SEO } from "astro-seo";
import FontConfig from "@/components/FontConfig.astro";
import og from "@/assets/og.png";

interface Props {
  title: string;
}

const { title } = Astro.props;
const description =
  "Need a fullstack developer? Documentation reading enjoyer, Constantly learning. It's JuanoD. With multiple years of experience developing and leading teams";
const site = "https://juanod.com";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      charset="UTF-8"
      canonical={site}
      openGraph={{
        basic: { title: title, type: "website", image: `${site}${og.src}` },
        optional: { locale: "en_US", description },
      }}
      twitter={{
        card: "summary_large_image",
        title: title,
        description,
        // site,
        image: `${site}${og.src}`,
        imageAlt: "JuanoD's portfolio Hero Section",
      }}
      extend={{
        meta: [
          { name: "theme-color", content: "#1e1e2e" },
          { name: "viewport", content: "width=device-width" },
          // { name: "generator", content: Astro.generator },
        ],
        link: [
          { rel: "icon", href: "/plague.svg", type: "image/svg+xml" },
          // { rel: "manifest", href: "/manifest.webmanifest" },
        ],
      }}
    />
    <FontConfig />
  </head>
  <body>
    <slot />
    <style is:global>
      @reference "@/styles/global.css";
      :root {
        --accent: 136, 58, 234;
        --accent-light: 224, 204, 250;
        --accent-dark: 49, 10, 101;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          rgb(var(--accent-light)) 30%,
          white 60%
        );
        color: theme(--color-ctp-text);
      }

      * {
        text-wrap: pretty;
      }

      ::selection {
        background-color: theme(--color-ctp-surface2 / 0.5);
        color: theme(--color-ctp-text);
      }
      html {
        font-family: system-ui, sans-serif;
        /* font-family: theme(fontFamily.fira-sans); */
        background: theme(--color-ctp-base);
        background-size: 224px;
      }

      html,
      body {
        scrollbar-gutter: stable;
        scroll-padding-top: theme(size.12);
        scroll-behavior: smooth;
      }

      a {
        @apply focus-visible:ring-2 focus-visible:ring-ctp-sky focus:outline-hidden focus-visible:outline-hidden rounded-sm text-ctp-blue hover:text-ctp-sky;
      }

      code {
        font-family:
          Menlo,
          Monaco,
          Lucida Console,
          Liberation Mono,
          DejaVu Sans Mono,
          Bitstream Vera Sans Mono,
          Courier New,
          monospace;
      }
    </style>
  </body>
</html>
